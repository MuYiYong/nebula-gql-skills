# Glob patterns are relative to the repository root.
# These files are copied into dist/gql-query-generator/tests/features/.

features/aggregate/Aggregate.feature
features/composite/composite.feature
features/datatype/decimal.feature
features/datatype/geo.feature
features/datatype/vector.feature
features/delete/Delete.feature
features/expr/*.feature
features/filter/Filter.feature
features/for/for.feature
features/function/*.feature
features/index/*.feature
features/insert/Insert.feature
features/let/Let.feature
features/match/*.feature
features/order_by_and_page/*.feature
features/parameter/Parameter.feature
features/return/Finish.feature
features/return/Return.feature
features/sample/Sample.feature
features/set/Set.feature
features/subquery/*.feature
features/topn/TopN.feature
# Explicitly keep graph variable query coverage aligned with USE g and graph-ref consumption rules.
features/variable/GraphVariable.feature
# Explicitly keep graph-variable alias, NEXT handoff, and working-graph boundary coverage in packaged tests.
features/variable/GraphVariableDefinition.feature
# Explicitly keep TABLE literal + FOR-consumption coverage in the packaged query-skill tests.
features/variable/BindingTableVariableDefinition.feature
